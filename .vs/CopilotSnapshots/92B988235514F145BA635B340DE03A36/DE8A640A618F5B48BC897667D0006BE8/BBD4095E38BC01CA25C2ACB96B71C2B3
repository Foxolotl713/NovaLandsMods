using Archipelago.MultiClient.Net;
using Archipelago.MultiClient.Net.Enums;
using MelonLoader;
using System;
using System.Reflection;
using System.Collections.Generic;
using UnityEngine;

[assembly: MelonInfo(typeof(NovaLandsArchipelago.Core), "NovaLandsArchipelago", "0.1.0", "Gott", null)]
[assembly: MelonGame("BEHEMUTT", "Nova Lands")]

namespace NovaLandsArchipelago
{
    public class Core : MelonMod
    {
        public static bool connected = false;
        private object archipelagoSession = null;
        private bool firstResearchLocationChecked = false;
        public override void OnInitializeMelon()
        {
            LoggerInstance.Msg("Initialized.");
            MelonEvents.OnGUI.Subscribe(DrawMenu, 100); // The higher the value, the lower the priority.
        }

        private string server = "";
        private string playerName = "";
        private string password = "";
        private enum FocusField { None, Server, Name, Password }
        private FocusField focused = FocusField.None;

        private void DrawMenu()
        {
            if (connected) return;
            // Layout values
            int x = 10;
            int y = 10;
            int width = 300;
            int height = 22;
            int labelWidth = 60;
            int spacing = 28;

            // Handle keyboard input when a field is focused
            Event e = Event.current;
            if (e.type == EventType.KeyDown && focused != FocusField.None)
            {
                if (e.keyCode == KeyCode.Backspace)
                {
                    switch (focused)
                    {
                        case FocusField.Server:
                            if (server.Length > 0) server = server.Substring(0, server.Length - 1);
                            break;
                        case FocusField.Name:
                            if (playerName.Length > 0) playerName = playerName.Substring(0, playerName.Length - 1);
                            break;
                        case FocusField.Password:
                            if (password.Length > 0) password = password.Substring(0, password.Length - 1);
                            break;
                    }
                }
                else if (e.keyCode == KeyCode.Return || e.keyCode == KeyCode.KeypadEnter)
                {
                    // finish editing on enter
                    focused = FocusField.None;
                }
                else
                {
                    char c = e.character;
                    if (!char.IsControl(c))
                    {
                        switch (focused)
                        {
                            case FocusField.Server:
                                server += c;
                                break;
                            case FocusField.Name:
                                playerName += c;
                                break;
                            case FocusField.Password:
                                password += c;
                                break;
                        }
                    }
                }
            }

            // Background box covering all fields
            GUI.Box(new Rect(x - 6, y - 8, width + 16, height * 3 + spacing * 2 + 16), "");

            // Server
            GUI.Label(new Rect(x, y, labelWidth, height), "Server:");
            string serverDisplay = server;
            if (focused == FocusField.Server) serverDisplay += "|";
            if (GUI.Button(new Rect(x + labelWidth, y, width - labelWidth, height), serverDisplay))
                focused = FocusField.Server;
            y += spacing;

            // Name
            GUI.Label(new Rect(x, y, labelWidth, height), "Name:");
            string nameDisplay = playerName;
            if (focused == FocusField.Name) nameDisplay += "|";
            if (GUI.Button(new Rect(x + labelWidth, y, width - labelWidth, height), nameDisplay))
                focused = FocusField.Name;
            y += spacing;

            // Password (masked)
            GUI.Label(new Rect(x, y, labelWidth, height), "Password:");
            string masked = new string('*', password.Length);
            if (focused == FocusField.Password) masked += "|";
            if (GUI.Button(new Rect(x + labelWidth, y, width - labelWidth, height), masked))
                focused = FocusField.Password;
            y += spacing;

            // Connect button
            if (GUI.Button(new Rect(x, y, 120, height), "Connect"))
            {
                var session = ArchipelagoSessionFactory.CreateSession(server);
                var version = Version.Parse("0.6.7");
                LoginResult result;
                // Call TryConnectAndLogin - remove the accidental empty array from the arguments
                result = session.TryConnectAndLogin("Nova Lands", playerName, ItemsHandlingFlags.AllItems, version, password);
                if (result.Successful)
                {
                    LoggerInstance.Msg("Successfully connected to Archipelago server!");
                    connected = true;
                    // keep a reference to the session (stored as object so we can reflectively call send methods)
                    archipelagoSession = session;
                }
                else
                {
                    LoggerInstance.Error($"Failed to connect: {result}");
                }
            }

            // If connected, allow testing the research purchase trigger
            if (connected)
            {
                y += spacing;
                if (GUI.Button(new Rect(x, y, 200, height), "Simulate Buy: First Research"))
                {
                    OnResearchPurchased();
                }
            }
        }

        // Call this when the player buys a research upgrade. It will check the "Test Location" the first time it is called.
        public void OnResearchPurchased()
        {
            if (firstResearchLocationChecked)
                return;

            firstResearchLocationChecked = true;

            if (archipelagoSession == null)
            {
                LoggerInstance.Msg("Not connected to an Archipelago session - cannot send location check.");
                return;
            }

            string locationName = "Test Location";

            // Try several likely method names via reflection to send a location check. This avoids compile-time
            // dependency on a specific client API name/signature.
            Type sessType = archipelagoSession.GetType();
            string[] candidateNames = new[] { "SendLocationChecks", "SendChecks", "SendLocationCheck", "SendLocation", "SendLocations" };

            foreach (var name in candidateNames)
            {
                MethodInfo mi = sessType.GetMethod(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
                if (mi == null) continue;

                var parameters = mi.GetParameters();
                try
                {
                    if (parameters.Length == 1)
                    {
                        var pType = parameters[0].ParameterType;
                        // If the method accepts a string[] or IEnumerable<string>
                        if (pType.IsArray && pType.GetElementType() == typeof(string))
                        {
                            mi.Invoke(archipelagoSession, new object[] { new string[] { locationName } });
                            LoggerInstance.Msg($"Sent location check for '{locationName}' using {name} (string[]).");
                            return;
                        }

                        if (typeof(IEnumerable<string>).IsAssignableFrom(pType))
                        {
                            mi.Invoke(archipelagoSession, new object[] { new List<string> { locationName } });
                            LoggerInstance.Msg($"Sent location check for '{locationName}' using {name} (IEnumerable<string>).");
                            return;
                        }

                        // If the method accepts a single string
                        if (pType == typeof(string))
                        {
                            mi.Invoke(archipelagoSession, new object[] { locationName });
                            LoggerInstance.Msg($"Sent location check for '{locationName}' using {name} (string).");
                            return;
                        }
                    }
                }
                catch (Exception ex)
                {
                    LoggerInstance.Error($"Failed invoking {name} on session: {ex}");
                }
            }

            LoggerInstance.Msg("No suitable send-check method found on Archipelago session. Location not sent.");
        }
    }
}